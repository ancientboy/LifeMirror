# Copy this file to .env.production on the Singapore server. Never commit the
# real file: it holds database and LLM credentials.
APP_DOMAIN=mirror.lumeword.com

POSTGRES_DB=life_mirror
POSTGRES_USER=life_mirror
# Use only letters and numbers here (for example: `openssl rand -hex 24`).
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://life_mirror:replace-with-a-long-random-password@postgres:5432/life_mirror

WEB_ORIGIN=https://mirror.lumeword.com
SESSION_COOKIE_NAME=life_mirror_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SAME_SITE=strict
REFLECTION_TOKEN_SECRET=replace-with-a-random-string-of-at-least-32-characters
METRICS_TOKEN=replace-with-a-random-string-of-at-least-24-characters

# Use the existing DeepSeek-compatible endpoint and key here. Keep LLM secrets
# only in this server file, never in the repository or GitHub Actions logs.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# One-time D1 → PostgreSQL migration. Generate a value with `openssl rand -hex
# 32`, store it in this file and as the D1_MIGRATION_TOKEN secret in Sites.
# Remove both after the verified migration finishes.
D1_MIGRATION_TOKEN=

# Needed for passwordless email login, matching the existing product flow.
# Keep the values only on the server.
RESEND_API_KEY=
EMAIL_FROM=
