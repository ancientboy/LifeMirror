# beta is the temporary migration origin. Caddy obtains a publicly trusted
# certificate so Cloudflare Full (strict) can verify the Singapore origin.
beta.lumeword.com {
  encode zstd gzip

  # Keep API traffic out of the static-app fallback.
  handle /api/* {
    reverse_proxy api:8787
  }

  handle {
    root * /usr/share/caddy
    try_files {path} {path}/ /index.html
    file_server
  }
}
