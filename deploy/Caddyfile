# The beta hostname is the temporary public origin during the D1 migration.
# Caddy terminates HTTPS here so Cloudflare can use a full HTTPS origin.
beta.lumeword.com {
  encode zstd gzip

  # Keep API traffic out of the static-app fallback.
  handle /api/* {
    reverse_proxy api:8787
  }

  handle {
    root * /usr/share/caddy
    try_files {path} {path}/ /index.html
    file_server
  }
}
