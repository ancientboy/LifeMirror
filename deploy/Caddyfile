# The beta hostname is the temporary public origin during the D1 migration.
# The edge proxy retains HTTPS to origin; Caddy's internal certificate avoids
# an external ACME challenge while this temporary hostname is proxied.
beta.lumeword.com {
  tls internal
  encode zstd gzip

  # Keep API traffic out of the static-app fallback.
  handle /api/* {
    reverse_proxy api:8787
  }

  handle {
    root * /usr/share/caddy
    try_files {path} {path}/ /index.html
    file_server
  }
}
