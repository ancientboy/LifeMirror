{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/daily-test",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": [
    "lib/daily-guidance.ts",
    "lib/daily-guidance.test.ts",
    "lib/question-routing.ts",
    "lib/question-routing.test.ts",
    "lib/mirror-result-quality.ts",
    "lib/mirror-result-quality.test.ts",
    "lib/share-safety.ts",
    "lib/share-safety.test.ts",
    "lib/safety-boundary.ts",
    "lib/safety-boundary.test.ts",
    "server/tools/astrology/**/*.ts",
    "server/tools/bazi/**/*.ts"
  ]
}
