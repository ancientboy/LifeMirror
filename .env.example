NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=8787
WEB_ORIGIN=http://localhost:4173
DATABASE_URL=postgres://life_mirror:life_mirror@localhost:5432/life_mirror
SESSION_COOKIE_NAME=life_mirror_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SAME_SITE=strict
REFLECTION_TOKEN_SECRET=replace-with-at-least-32-random-characters
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional automatic backup. Used only for network/timeout, 429/5xx, or empty-response failures from the primary.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Optional: enables live verification in the Shiguang web conversation. The default endpoint expects Tavily's Search API format.
SHIGUANG_WEB_SEARCH_API_KEY=
SHIGUANG_WEB_SEARCH_URL=https://api.tavily.com/search
NEXT_PUBLIC_API_URL=http://localhost:8787
RESEND_API_KEY=
EMAIL_FROM=LifeMirror <login@auth.lumeword.com>
# Required by the API and the Sites Worker when exposing private operational
# aggregates. Never place this value in NEXT_PUBLIC_* variables.
METRICS_TOKEN=replace-with-a-random-secret-at-least-24-characters
# Optional separate operations token; falls back to METRICS_TOKEN when absent.
OPS_TOKEN=
# Comma-separated emails allowed to open the authenticated operations console.
OPS_ADMIN_EMAILS=
# Set a hard daily LLM ceiling in micro-USD. 0 disables the ceiling.
LLM_DAILY_BUDGET_MICROUSD=0
LLM_INPUT_MICROUSD_PER_1K=100
LLM_OUTPUT_MICROUSD_PER_1K=400
LLM_FAILURE_ALERT_RATE=0.1
LLM_LATENCY_ALERT_MS=12000
# External relationship email remains off until both this deploy flag and the
# individual user's email preference are enabled.
EXTERNAL_NOTIFICATION_EMAIL_ENABLED=false
SOURCE_COMMIT=
